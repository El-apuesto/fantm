# fantm.ink Backend Environment Variables
# Copy this to .env and fill in your actual values

PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=your-supabase-url-here
SUPABASE_SERVICE_KEY=your-supabase-service-key-here
DATABASE_URL=your-database-url-here

# Grok API (xAI)
GROK_API_KEY=your-grok-api-key-here

# Groq API (for testing - faster than Grok)
GROQ_API_KEY=your-groq-api-key-here

# Square Payments
SQUARE_ACCESS_TOKEN=your-square-access-token-here
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=your-square-location-id-here

# Optional: Valkey (Redis-compatible) for caching
VALKEY_URL=valkey://localhost:6379
